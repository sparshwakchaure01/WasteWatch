{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered system user profile with assigned municipal or citizen role.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["Reporter", "Local Body", "Administrator"] },
        "status": { "type": "string", "enum": ["Active", "Deactivated"] },
        "department": { "type": "string", "maxLength": 100 },
        "jurisdictionZone": { "type": "string", "maxLength": 100 },
        "createdBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "phone", "role", "status", "createdAt"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Illegal dumping or municipal waste report.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "reporterName": { "type": "string", "maxLength": 100 },
        "reporterPhone": { "type": "string", "maxLength": 20 },
        "photoUrl": { "type": "string", "maxLength": 500000 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "locationName": { "type": "string", "maxLength": 200 },
        "category": {
          "type": "string",
          "enum": ["Plastic Waste", "Household Waste", "Construction Debris", "Garden Waste", "Electronic Waste", "Other"]
        },
        "description": { "type": "string", "maxLength": 2000 },
        "status": {
          "type": "string",
          "enum": ["Pending Approval", "Pending", "In Progress", "Resolved", "Rejected"]
        },
        "rejectionReason": { "type": "string", "maxLength": 1000 },
        "rejectedBy": { "type": "string", "maxLength": 100 },
        "rejectedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "type": "string", "maxLength": 100 },
        "approvedAt": { "type": "string", "format": "date-time" },
        "hotspotId": { "type": "string", "maxLength": 64 },
        "resolvedBy": { "type": "string", "maxLength": 100 },
        "resolutionNotes": { "type": "string", "maxLength": 1000 },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterId", "reporterName", "reporterPhone", "latitude", "longitude", "locationName", "category", "description", "status", "createdAt"]
    },
    "Hotspot": {
      "title": "Hotspot",
      "description": "Geospatial cluster of frequent waste dumping reports.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "centerLat": { "type": "number" },
        "centerLng": { "type": "number" },
        "locationName": { "type": "string", "maxLength": 200 },
        "complaintCount": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Under Clean-Up", "Cleared"] },
        "primaryCategory": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "centerLat", "centerLng", "locationName", "complaintCount", "status", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable administrative action log.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "format": "date-time" },
        "userUid": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "complaintId": { "type": "string", "maxLength": 64 },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 2000 }
      },
      "required": ["id", "timestamp", "userUid", "userName", "userRole", "action", "details"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile accounts collection"
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "Municipal waste dumping complaint reports"
    },
    "/hotspots/{hotspotId}": {
      "schema": { "$ref": "#/entities/Hotspot" },
      "description": "Geospatial waste accumulation hotspots"
    },
    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "System audit and security action log"
    }
  }
}
